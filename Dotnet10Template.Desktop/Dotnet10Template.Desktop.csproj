<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Dotnet10Template.Desktop</RootNamespace>
    <AssemblyName>$(DesktopExecutableName)</AssemblyName>
    <Version>$(ProductVersion)</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <WebProjectDir>$(MSBuildProjectDirectory)\..\src\dotnet10template.web\</WebProjectDir>
    <ApiProjectPath>$(MSBuildProjectDirectory)\..\src\Dotnet10Template.Api\Dotnet10Template.Api.csproj</ApiProjectPath>
    <RuntimeHostProjectPath>$(MSBuildProjectDirectory)\..\src\Dotnet10Template.RuntimeHost\Dotnet10Template.RuntimeHost.csproj</RuntimeHostProjectPath>
    <PostgresRuntimeDir>$(MSBuildProjectDirectory)\Runtime\Postgres\</PostgresRuntimeDir>
    <DesktopApiRuntimeArgs Condition="'$(RuntimeIdentifier)' != ''">--runtime &quot;$(RuntimeIdentifier)&quot; --self-contained true</DesktopApiRuntimeArgs>
    <DesktopApiRuntimeArgs Condition="'$(RuntimeIdentifier)' == ''">--no-self-contained</DesktopApiRuntimeArgs>
    <DesktopRuntimeHostRuntimeArgs Condition="'$(RuntimeIdentifier)' != ''">--runtime &quot;$(RuntimeIdentifier)&quot; --self-contained true</DesktopRuntimeHostRuntimeArgs>
    <DesktopRuntimeHostRuntimeArgs Condition="'$(RuntimeIdentifier)' == ''">--no-self-contained</DesktopRuntimeHostRuntimeArgs>
    <DesktopWebProductEnv>set VITE_PRODUCT_DISPLAY_NAME=$(ProductDisplayName)&amp;&amp; set VITE_PRODUCT_SHORT_NAME=$(ProductShortName)&amp;&amp;</DesktopWebProductEnv>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DesktopWebDistPath</_Parameter1>
      <_Parameter2>$(WebProjectDir)dist</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DesktopApiPublishPath</_Parameter1>
      <_Parameter2>$(OutDir)Api</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DesktopRuntimeHostPublishPath</_Parameter1>
      <_Parameter2>$(OutDir)RuntimeHost</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DesktopApiExecutableName</_Parameter1>
      <_Parameter2>$(ApiExecutableName)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DesktopPostgresRuntimePath</_Parameter1>
      <_Parameter2>$(PostgresRuntimeDir)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Runtime\Postgres\**\*.*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ExcludePostgresRuntimeFromPriIndex"
          BeforeTargets="_GenerateProjectPriConfigurationFiles">
    <ItemGroup>
      <PriOutputs Remove="@(PriOutputs)"
                  Condition="$([System.String]::Copy('%(PriOutputs.TargetPath)').StartsWith('Runtime\Postgres\'))" />
      <PriOutputs Remove="@(PriOutputs)"
                  Condition="$([System.String]::Copy('%(PriOutputs.TargetPath)').StartsWith('Files\Runtime\Postgres\'))" />
    </ItemGroup>
  </Target>

  <Target Name="StampPackageManifestProductIdentity"
          BeforeTargets="Build;_GenerateAppxPackageFile">
    <XmlPoke XmlInputPath="Package.appxmanifest"
             Namespaces="&lt;Namespace Prefix='pkg' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;&lt;Namespace Prefix='mp' Uri='http://schemas.microsoft.com/appx/2014/phone/manifest' /&gt;&lt;Namespace Prefix='uap' Uri='http://schemas.microsoft.com/appx/manifest/uap/windows10' /&gt;"
             Query="/pkg:Package/pkg:Identity/@Name"
             Value="$(ProductPackageIdentityName)" />
    <XmlPoke XmlInputPath="Package.appxmanifest"
             Namespaces="&lt;Namespace Prefix='pkg' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;"
             Query="/pkg:Package/pkg:Identity/@Publisher"
             Value="$(ProductPublisher)" />
    <XmlPoke XmlInputPath="Package.appxmanifest"
             Namespaces="&lt;Namespace Prefix='pkg' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;"
             Query="/pkg:Package/pkg:Identity/@Version"
             Value="$(ProductPackageVersion)" />
    <XmlPoke XmlInputPath="Package.appxmanifest"
             Namespaces="&lt;Namespace Prefix='pkg' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;&lt;Namespace Prefix='mp' Uri='http://schemas.microsoft.com/appx/2014/phone/manifest' /&gt;"
             Query="/pkg:Package/mp:PhoneIdentity/@PhoneProductId"
             Value="$(ProductPhoneProductId)" />
    <XmlPoke XmlInputPath="Package.appxmanifest"
             Namespaces="&lt;Namespace Prefix='pkg' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;&lt;Namespace Prefix='mp' Uri='http://schemas.microsoft.com/appx/2014/phone/manifest' /&gt;"
             Query="/pkg:Package/mp:PhoneIdentity/@PhonePublisherId"
             Value="$(ProductPhonePublisherId)" />
    <XmlPoke XmlInputPath="Package.appxmanifest"
             Namespaces="&lt;Namespace Prefix='pkg' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;"
             Query="/pkg:Package/pkg:Properties/pkg:DisplayName"
             Value="$(ProductDisplayName)" />
    <XmlPoke XmlInputPath="Package.appxmanifest"
             Namespaces="&lt;Namespace Prefix='pkg' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;"
             Query="/pkg:Package/pkg:Properties/pkg:PublisherDisplayName"
             Value="$(ProductPublisherDisplayName)" />
    <XmlPoke XmlInputPath="Package.appxmanifest"
             Namespaces="&lt;Namespace Prefix='pkg' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;&lt;Namespace Prefix='uap' Uri='http://schemas.microsoft.com/appx/manifest/uap/windows10' /&gt;"
             Query="/pkg:Package/pkg:Applications/pkg:Application/uap:VisualElements/@DisplayName"
             Value="$(ProductDisplayName)" />
    <XmlPoke XmlInputPath="Package.appxmanifest"
             Namespaces="&lt;Namespace Prefix='pkg' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;&lt;Namespace Prefix='uap' Uri='http://schemas.microsoft.com/appx/manifest/uap/windows10' /&gt;"
             Query="/pkg:Package/pkg:Applications/pkg:Application/uap:VisualElements/@Description"
             Value="$(ProductDisplayName)" />
  </Target>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug' and '$(RuntimeIdentifier)' == ''">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug' and '$(RuntimeIdentifier)' != ''">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug' and '$(RuntimeIdentifier)' == ''">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug' and '$(RuntimeIdentifier)' != ''">True</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <DesktopWebBuildInput Include="$(WebProjectDir)index.html" />
    <DesktopWebBuildInput Include="$(WebProjectDir)package.json" />
    <DesktopWebBuildInput Include="$(WebProjectDir)package-lock.json" />
    <DesktopWebBuildInput Include="$(WebProjectDir)tsconfig*.json" />
    <DesktopWebBuildInput Include="$(WebProjectDir)vite.config.ts" />
    <DesktopWebBuildInput Include="$(WebProjectDir)public\**\*.*" />
    <DesktopWebBuildInput Include="$(WebProjectDir)src\**\*.*" />
  </ItemGroup>

  <Target Name="RestoreDesktopWebPackages"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(WebProjectDir)package.json;$(WebProjectDir)package-lock.json"
          Outputs="$(WebProjectDir)node_modules\.package-lock.json">
    <Exec Command="npm ci" WorkingDirectory="$(WebProjectDir)" />
  </Target>

  <Target Name="BuildDesktopWebAssets"
          Condition="'$(DesignTimeBuild)' != 'true'"
          DependsOnTargets="RestoreDesktopWebPackages"
          Inputs="@(DesktopWebBuildInput)"
          Outputs="$(WebProjectDir)dist\index.html">
    <Exec Command="$(DesktopWebProductEnv) npm run build" WorkingDirectory="$(WebProjectDir)" />
  </Target>

  <Target Name="CopyDesktopWebAssets"
          Condition="'$(DesignTimeBuild)' != 'true'"
          DependsOnTargets="BuildDesktopWebAssets"
          AfterTargets="Build">
    <ItemGroup>
      <DesktopWebAsset Include="$(WebProjectDir)dist\**\*.*" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)WebAssets" />
    <MakeDir Directories="$(OutDir)WebAssets" />
    <Copy SourceFiles="@(DesktopWebAsset)"
          DestinationFiles="@(DesktopWebAsset->'$(OutDir)WebAssets\%(RecursiveDir)%(Filename)%(Extension)')" />
    <MakeDir Directories="$(OutDir)AppX\WebAssets" />
    <Copy SourceFiles="@(DesktopWebAsset)"
          DestinationFiles="@(DesktopWebAsset->'$(OutDir)AppX\WebAssets\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="CopyDesktopHostFilesToAppx"
          Condition="'$(DesignTimeBuild)' != 'true'"
          AfterTargets="Build">
    <ItemGroup>
      <DesktopHostOutput Include="$(OutDir)*.*" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)AppX" />
    <Copy SourceFiles="@(DesktopHostOutput)"
          DestinationFiles="@(DesktopHostOutput->'$(OutDir)AppX\%(Filename)%(Extension)')" />
  </Target>

  <Target Name="PublishDesktopApi"
          Condition="'$(DesignTimeBuild)' != 'true'"
          AfterTargets="Build">
    <RemoveDir Directories="$(OutDir)Api" />
    <Exec Command="dotnet publish &quot;$(ApiProjectPath)&quot; --nologo --configuration &quot;$(Configuration)&quot; $(DesktopApiRuntimeArgs) --output &quot;$(OutDir)Api&quot; -p:UseAppHost=true -p:PublishSingleFile=false" />
    <ItemGroup>
      <DesktopApiAsset Include="$(OutDir)Api\**\*.*" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)AppX\Api" />
    <MakeDir Directories="$(OutDir)AppX\Api" />
    <Copy SourceFiles="@(DesktopApiAsset)"
          DestinationFiles="@(DesktopApiAsset->'$(OutDir)AppX\Api\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="PublishDesktopRuntimeHost"
          Condition="'$(DesignTimeBuild)' != 'true'"
          AfterTargets="Build">
    <RemoveDir Directories="$(OutDir)RuntimeHost" />
    <Exec Command="dotnet publish &quot;$(RuntimeHostProjectPath)&quot; --nologo --configuration &quot;$(Configuration)&quot; $(DesktopRuntimeHostRuntimeArgs) --output &quot;$(OutDir)RuntimeHost&quot; -p:UseAppHost=true -p:PublishSingleFile=false" />
    <ItemGroup>
      <DesktopRuntimeHostAsset Include="$(OutDir)RuntimeHost\**\*.*" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)AppX\RuntimeHost" />
    <MakeDir Directories="$(OutDir)AppX\RuntimeHost" />
    <Copy SourceFiles="@(DesktopRuntimeHostAsset)"
          DestinationFiles="@(DesktopRuntimeHostAsset->'$(OutDir)AppX\RuntimeHost\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="IncludeDesktopOwnedRuntimePayload"
          BeforeTargets="_GenerateAppxPackageFile"
          DependsOnTargets="CopyDesktopWebAssets;PublishDesktopApi;PublishDesktopRuntimeHost">
    <ItemGroup>
      <DesktopPackagedWebAsset Include="$(OutDir)WebAssets\**\*.*" />
      <DesktopPackagedApiAsset Include="$(OutDir)Api\**\*.*" />
      <DesktopPackagedRuntimeHostAsset Include="$(OutDir)RuntimeHost\**\*.*" />
      <AppxPackagePayload Include="@(DesktopPackagedWebAsset)">
        <TargetPath>WebAssets\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      </AppxPackagePayload>
      <AppxPackagePayload Include="@(DesktopPackagedApiAsset)">
        <TargetPath>Api\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      </AppxPackagePayload>
      <AppxPackagePayload Include="@(DesktopPackagedRuntimeHostAsset)">
        <TargetPath>RuntimeHost\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      </AppxPackagePayload>
    </ItemGroup>
  </Target>
</Project>

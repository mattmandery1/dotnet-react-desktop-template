# Keep Docker contexts rooted at the repository while excluding local state and
# generated output that is not needed by the API or web image builds.

# Git/editor/local state
.git
.gitignore
.gitattributes
.github
.vs
.vscode
**/.classpath
**/.project
**/.settings
**/.toolstarget
**/*.*proj.user
**/*.dbmdl
**/*.jfm
**/azds.yaml
**/secrets.dev.yaml
**/values.dev.yaml
**/npm-debug.log

# Local environment and certificates
.env
.env.*
.certificates

# Build/package outputs
artifacts
**/artifacts
**/bin
**/obj
**/dist
**/node_modules
**/AppPackages
**/BundleArtifacts
AppPackages

# Desktop-only runtime/package payloads; excluded from Docker context only.
Dotnet10Template.Desktop

# Tests are run from the host and are not required for API/web image builds.
tests

# Repo documentation and non-build metadata
docs
LICENSE
README.md

# Compose files are used by the CLI before context upload, not by image builds.
compose*.yaml
compose*.yml
docker-compose*.yaml
docker-compose*.yml

# Central build metadata required by API/web Dockerfiles.
!Directory.Build.props
!Directory.Product.props
!Directory.Packages.props
